@model Veritas.Web.Modules.AccessRequest.Presentation.AccessRequestsIndexViewModel
@{
    ViewData["Title"] = "Access Requests";
    var status = Model.Status?.ToString();
    var pageSize = Model.PageSize;
    var pager = new Veritas.Web.Shared.Presentation.PagerModel
    {
        Total = Model.Total, Page = Model.Page, PageSize = pageSize,
        UrlFor = page => Url.Action("Index", new { status, page, pageSize })
    };
}

<div class="page-header">
    <div><h1>Access Requests</h1><p class="lede">Every request records its approval chain, justification and risk score.</p></div>
    <div class="page-header__actions"><a class="btn btn--sm btn--primary" asp-action="Create">Request access</a></div>
</div>

<form class="filters" method="get" asp-action="Index" data-filter-form>
    <input type="hidden" name="pageSize" value="@pageSize" />
    <div class="field">
        <label class="field__label" for="status">Status</label>
        <select class="select" id="status" name="status" data-autosubmit>
            <option value="">All</option>
            @foreach (var option in new[] { "Requested", "ManagerReview", "ResourceOwnerReview", "SecurityReview", "Approved", "Denied", "Granted", "Expired" })
            {
                <option value="@option" selected="@(status == option)">@option</option>
            }
        </select>
    </div>
</form>

<section class="panel">
    <div class="panel__body panel__body--flush table-scroll">
        <table class="data-table" data-sortable>
            <thead><tr><th scope="col" data-sort-key>Requester</th><th scope="col" data-sort-key>Resource</th><th scope="col" data-sort-key>Permission</th><th scope="col" data-sort-key>Duration</th><th scope="col" data-sort-key>Status</th><th scope="col" data-sort-key>Approval</th><th scope="col" data-sort-key>Requested (UTC)</th><th scope="col" data-sort-key>Expires (UTC)</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <th scope="row"><a asp-action="Details" asp-route-id="@item.Id">@item.Requester</a></th>
                    <td>@item.Resource</td>
                    <td class="mono small">@item.PermissionKey</td>
                    <td class="small">@item.Duration.ToString()</td>
                    <td><span class="badge badge--@(item.Status.ToString() switch { "Granted" => "ok", "Denied" or "Expired" => "alarm", _ => "warn" })">@item.Status</span></td>
                    <td class="small">@item.StepsDecided / @item.StepsTotal steps</td>
                    <td class="audit-timestamp">@item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="audit-timestamp">@(item.ExpiresAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                </tr>
            }
            @if (Model.Items.Count == 0) { <tr><td colspan="8"><p class="empty-state">No access requests match this filter.</p></td></tr> }
            </tbody>
        </table>
    </div>
    <div class="panel__footer"><partial name="_Pager" model="@pager" /></div>
</section>
