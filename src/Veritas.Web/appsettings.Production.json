{
  "DetailedErrors": false,
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "OpenTelemetry": "Warning"
      }
    }
  },
  "Veritas": {
    "Security": {
      "EnableHsts": true,
      "HstsMaxAgeDays": 365
    }
  }
}
