{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [ { "Name": "Console" } ]
  },
  "Veritas": {
    "Database": {
      "CommandTimeoutSeconds": 60,
      "MaxPoolSize": 64,
      "AutoMigrate": false
    },
    "Redis": {
      "FailOpen": true,
      "ConnectTimeoutMs": 2000,
      "PolicyCacheTtlSeconds": 300,
      "IdempotencyTtlSeconds": 600
    },
    "Security": {
      "RiskVerificationThreshold": 30,
      "RiskApprovalThreshold": 60,
      "RiskDenyThreshold": 80,
      "MaxTemporaryGrantDuration": "08:00:00",
      "MaxPrivilegedSessionDuration": "02:00:00",
      "EnableHsts": true,
      "HstsMaxAgeDays": 365
    },
    "Identity": {
      "PasswordMinLength": 12,
      "RequireNonAlphanumeric": true,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireConfirmedEmail": true,
      "MaxFailedAccessAttempts": 5,
      "LockoutDuration": "00:15:00",
      "SessionLifetime": "08:00:00",
      "SecurityStampValidationInterval": "00:05:00"
    },
    "RateLimit": {
      "AuthorizationPermitsPerSecond": 50,
      "AuthorizationQueueLimit": 20,
      "LoginPermitsPerMinute": 10,
      "AdminApiPermitsPerSecond": 20,
      "AccessRequestPermitsPerSecond": 20,
      "AuditPermitsPerSecond": 30,
      "ApiKeyAuthPermitsPerSecond": 100
    },
    "Audit": {
      "RetentionDays": 400,
      "MaxPageSize": 100
    },
    "Notification": {
      "MaxDeliveryAttempts": 5,
      "WorkerPollInterval": "00:00:10",
      "WebhookTimeout": "00:00:10",
      "OutboxBatchSize": 50
    },
    "Workers": {
      "TemporaryAccessPollInterval": "00:00:15",
      "SecurityDetectionPollInterval": "00:01:00",
      "AccessReviewPollInterval": "00:15:00",
      "CleanupPollInterval": "06:00:00",
      "RiskEvaluationPollInterval": "00:05:00",
      "BatchSize": 250
    }
  }
}
